# Mellotron-style tape replay keyboard: looped tape recordings on three tracks.
#
# src/mello/ is the engine - portable C++, no Pico dependency, also built on
# the host by tools/host_tests/mt. src/data/ is the sample bank generated by
# tools/mt_sampleprep/sf2_to_cpp.py (about 3 MB of 16-bit PCM); regenerate it
# there rather than editing it.
picoface_add_instrument(
    NAME PicoFaceMT
    PROGRAM_NAME "PicoFaceMT"
    USB_PID 0x105D
    DIR ${PICOFACE_CURRENT_INSTRUMENT_DIR}

    SOURCES
        # Adapter implementing picoface::Instrument: MIDI, panel, settings
        src/MT_Instrument.cpp
        src/mello/engine.cpp
        src/data/mello_bank.cpp
        src/data/mello_click.cpp
        src/data/mello_gc3_brass.cpp
        src/data/mello_m300a_violins.cpp
        src/data/mello_m300b_violin.cpp
        src/data/mello_m400_cello.cpp
        src/data/mello_m400_cmb_choir.cpp
        src/data/mello_m400_string_section.cpp
        src/data/mello_m400_woodwind2.cpp
        src/data/mello_mkii_3_violins.cpp
        src/data/mello_mkii_brass.cpp
        src/data/mello_mkii_flute.cpp

    INCLUDE_DIRS
        include
        src/data

    CORE_MODULES
        ui_kit     # shared panel look: header, knobs, two-value body

    DEFINES
        PICO_USE_SW_SPIN_LOCKS=1
)
