	(text "MIDI IN: tip -> J8.1, ring -> J8.2, sleeve -> J8.3\n(open; C8 on the front board is the optional RF cap)"
		(exclude_from_sim no)
		(at 50.8 55.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "f400f899-65ff-49ad-93cd-9946ec3a3992")
	)
	(text "MIDI OUT: tip -> J8.4, ring -> J8.5, sleeve -> J8.6 (GND)"
		(exclude_from_sim no)
		(at 50.8 91.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "61b14bbc-118b-40f5-8839-341359016a5a")
	)
	(text "OUT L: tip -> J8.7, sleeve -> J8.8 (GND)"
		(exclude_from_sim no)
		(at 50.8 121.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
