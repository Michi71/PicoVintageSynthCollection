#VRML V2.0 utf8
# Display module envelope. The 1.3" I2C module has no KiCad footprint of its own
# here -- it is held by four M2 standoffs and connected through DS1 -- so this is
# an envelope, not a model: outer size 35.4 x 33.5 and thickness 2.8 mm are
# measured off the part, the split into 1.6 mm carrier and 1.2 mm glass is a
# guess that only affects what it looks like, not what it occupies.
#
# It rides on 3.5 mm standoffs, so the front face lands 6.3 mm above the board
# and the gap to the panel is 6.5 mm. That 0.2 mm is the whole reason this file
# exists.
#
# Anchored to H1, the display's top-left M2 hole at board (7.30, 3.50).
# VRML units are 0.1 inch, hence millimetres / 2.54 throughout.
Transform { children [
  # carrier PCB
  Transform { translation 5.98425 -5.61024 1.69291
    children Shape {
      appearance Appearance { material Material { diffuseColor 0.05 0.09 0.30 specularColor 0.2 0.2 0.2 shininess 0.2 } }
      geometry Box { size 13.93701 13.18898 0.62992 }
    }
  }

  # glass
  Transform { translation 5.98425 -4.92126 2.24409
    children Shape {
      appearance Appearance { material Material { diffuseColor 0.04 0.04 0.05 specularColor 0.2 0.2 0.2 shininess 0.75 } }
      geometry Box { size 11.88976 8.66142 0.47244 }
    }
  }

]}