	(text "This project exists so the front board can have a layout: KiCad wants one board per project.\nThe schematic is the same file the hierarchical project uses -- there is one copy, not two.\n\nThe 20 global labels are what leaves this board: 19 through J3 / J4 to the main board, plus the\nMIDI IN sleeve. They repeat names that are local labels inside the sheet, so ERC rule\nsame_local_global_label is set to ignore in this project only."
		(exclude_from_sim no)
		(at 25.4 126.0 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2d37f6e6-c26f-4ed3-b848-ddf455cb4376")
	)
	(sheet_instances
		(path "/"
			(page "1")
		)
	)
	(embedded_fonts no)
	(text "GND, +3V3 and VSYS reach this board through J3 -- there is no source on it, so ERC rule\npower_pin_not_driven is set to ignore in this project only. The hierarchical project,\nwhere the module actually drives those rails, is checked with it on."
		(exclude_from_sim no)
		(at 168.0 92.0 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "0bd17e05-1c63-4c37-a8eb-e48ac01c3a50")
	)
)
